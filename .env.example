# Copy to .env. Never commit .env.

# none | api_key | oauth
AUTH_MODE=none
API_KEY=change-me

DATABASE_URL=postgresql+asyncpg://fitgen:fitgen@localhost:5433/fitgen
# Used by tests; wiped on every DB test run.
TEST_DATABASE_URL=postgresql+asyncpg://fitgen:fitgen@localhost:5433/fitgen_test

# groq | bedrock
LLM_PROVIDER=groq
GROQ_API_KEY=

# local | sqs
QUEUE_BACKEND=local

# AWS (only used when LLM_PROVIDER=bedrock or QUEUE_BACKEND=sqs)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
SQS_QUEUE_URL=
