# Copy to .env. Never commit .env.

# none | api_key | oauth
AUTH_MODE=none
API_KEY=change-me

DATABASE_URL=postgresql+asyncpg://fitgen:fitgen@localhost:5434/fitgen
# Used by tests; wiped on every DB test run.
TEST_DATABASE_URL=postgresql+asyncpg://fitgen:fitgen@localhost:5434/fitgen_test

# Background AI jobs (never on the request path). groq | bedrock
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
WORKER_ENABLED=true
# Regenerate the weekly insight this long after the last log_workout.
INSIGHT_DEBOUNCE_MINUTES=10

# local | sqs
QUEUE_BACKEND=local

# AWS (only used when LLM_PROVIDER=bedrock or QUEUE_BACKEND=sqs)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
SQS_QUEUE_URL=
